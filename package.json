{
  "name": "vite-to-pdf",
  "version": "2.0.0",
  "description": "Markdown/MDX report workspace with Vite, React, Tailwind and Playwright PDF export",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pdf": "vite build && bun scripts/export-pdf.ts",
    "typecheck": "tsc --noEmit",
    "pdf:install": "playwright install chromium"
  },
  "author": "Kyung Lee",
  "license": "ISC",
  "dependencies": {
    "gray-matter": "^4.0.3",
    "katex": "^0.19.1",
    "mermaid": "^12.3.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1",
    "sirv": "^3.0.2"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "rehype-katex": "^7.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx-frontmatter": "^6.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
